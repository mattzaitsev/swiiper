# Copy to .env and fill in. Only the scraper worker uses the proxy; the API and UI run without it.

# ── Oxylabs proxy ────────────────────────────────────────────────────────────
# Use the PROXY USER you created in the Oxylabs dashboard (Proxies → Users), not the Web API key.
# With or without its prefix: "myuser" and "customer-myuser" both work.
OXYLABS_PROXY_USERNAME=
OXYLABS_PROXY_PASSWORD=
# Or keep the credentials out of the environment: put "username:password" in a file that Git
# ignores (e.g. ./oxylabs-proxy.txt) and point to it here. The file wins over the two lines above.
# OXYLABS_PROXY_CREDENTIALS_PATH=./oxylabs-proxy.txt

# residential | mobile | datacenter | isp | dedicated-datacenter | dedicated-isp
OXYLABS_PROXY_PRODUCT=residential
# Exit country (2 letters). Residential/mobile: also a US state, e.g. us_california.
OXYLABS_PROXY_COUNTRY=US
OXYLABS_PROXY_STATE=
# Residential/mobile only: 0 = a new IP per request; 1-1440 = keep one IP for that many minutes.
OXYLABS_PROXY_SESSION_MINUTES=0
# Optional host:port override, e.g. a dedicated IP's port from the dashboard: ddc.oxylabs.io:8001
OXYLABS_PROXY_ENDPOINT=
# 1 = open a fresh connection for every request.
PROXY_FORCE_CLOSE=0

# ── 18+ communities ──────────────────────────────────────────────────────────
# Reddit's RSS doesn't say which communities are 18+, so Swiiper guesses from the name.
# Correct the guess with comma-separated names. 18+ ones stay out of For you until the viewer opts in.
NSFW_SUBREDDITS=
SFW_SUBREDDITS=

# ── Ingestion ────────────────────────────────────────────────────────────────
REDDIT_USER_AGENT=swiiper-sandbox/1.0
SUBREDDITS=pics,aww,gaming
POLL_SECONDS=300
