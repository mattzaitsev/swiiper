# Copy to .env. Use the EXACT credentials and port from Webshare's Endpoint Generator.
# Choose Rotating there if wanted; do not generate 2,000 guessed usernames.
# Option A: exported host:port:username:password file (overrides credentials below).
# Windows example: PROXY_LIST_PATH=C:/Users/yourname/Downloads/proxies.txt
PROXY_LIST_PATH=./proxies.example.txt
# Option B: leave proxies.example.txt as its empty placeholder and set these credentials.
PROXY_URL=http://p.webshare.io:80
PROXY_AUTH_MODE=credentials
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_FORCE_CLOSE=0
REDDIT_USER_AGENT=swiiper-sandbox/1.0
SUBREDDITS=pics,aww,gaming
POLL_SECONDS=300
